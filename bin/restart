#!/usr/bin/env bash
# Restart velo, wait for it to answer, then report status.
#
#   bin/restart
#
# Picks up a changed systemd unit only if bin/install-units has rewritten it
# first — systemd restarts the unit it has, not the template in deploy/.
# bin/deploy does both in the right order.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

# Port read the same way every other script reads it, with a literal fallback.
# This line used to be the bug in scripts of this shape: a hardcoded port in the
# wait loop turns a successful restart on a moved instance into a reported
# failure, on the one command whose whole job is to say whether it worked.
PORT="${PORT:-9422}"

unit_is_ours() {
  systemctl cat "$SERVICE_NAME" >/dev/null 2>&1 || return 1
  local d; d="$(systemctl show "$SERVICE_NAME" -p WorkingDirectory --value 2>/dev/null)"
  [[ -n "$d" && "$(cd "$d" 2>/dev/null && pwd)" == "$ROOT" ]]
}

if unit_is_ours; then
  echo "==> systemctl restart $SERVICE_NAME"
  sudo systemctl restart "$SERVICE_NAME"
else
  "$ROOT/bin/stop"
  "$ROOT/bin/start" --quiet
fi

# systemctl returns when the unit is started, not when the app has bound its
# port. Without this wait, bin/status below curls a socket nothing is listening
# on yet and reports a false failure.
echo "==> waiting for health on 127.0.0.1:${PORT}"
for i in $(seq 1 30); do
  if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:${PORT}/api/health" 2>/dev/null; then
    echo "    ready after ${i}s"
    break
  fi
  if [[ "$i" == "30" ]]; then
    echo "    still not healthy after 30s — see bin/logs" >&2
  fi
  sleep 1
done

exec "$ROOT/bin/status"
