#!/usr/bin/env bash
# Turn a bin/solve --json payload into src/solver/measured.ts, the one place the
# client can read a measured difficulty score from.
#
#   bin/solve levels/*.json --jobs 5 --optimise --time 720 --json /tmp/par.json
#   bin/difficulty-import /tmp/par.json
#
# --also MERGES A SECOND MEASURING RUN of the same levels, by the same rules the
# solver uses inside one run: the smallest par wins the time, and the line a
# fumble kills you on least often wins the score. Use it when a level had to be
# re-solved on a bigger budget, or to hand the scorer more lines to choose from:
#
#   bin/difficulty-import /tmp/par.json --also /tmp/gate.json /tmp/retry.json
#
# Route tension costs a second whole solve per level, so it is a separate run
# and is merged in by simHash:
#
#   bin/solve levels/*.json --jobs 5 --optimise --tension --time 720 --json /tmp/tension.json
#   bin/difficulty-import /tmp/par.json --tension /tmp/tension.json
#
# WHY IT IS A SCRIPT AND NOT A HAND-EDITED FILE. The difficulty numbers are
# measured from what the solver's search experienced, and producing them is
# about an hour of CPU across the twenty levels — far too expensive for the
# client, and too expensive for CI. So they are a build-time artefact. The
# failure mode of any such artefact is that it rots: somebody moves an apple,
# the number stays, and the game shows a confident rating for geometry that no
# longer exists. Two things stop that:
#
#   * every row is keyed by the level's simHash AND the sim rev, so an edited
#     level simply stops matching and the chooser says "unrated";
#   * every row records the MODE it was measured in — which line, which hands,
#     which budget, which seed, which scoreRev — because the same geometry
#     scores up to fourteen composite points apart on the gate's line and on the
#     optimiser's, and a row that does not say how it was measured is a row
#     nobody can trust later. A payload without a `mode` is refused;
#   * the generated file says it is generated and names this command, so the
#     honest way to change a number is to re-run the solver.
#
# The output path defaults to src/solver/measured.ts and can be overridden with
# a second argument. Exit status: 0 wrote the file, 2 bad usage, a payload that
# mixes sim revs or scoreRevs, or a row with no `mode`.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
[[ $# -ge 1 ]] || { echo "usage: bin/difficulty-import <solved.json> [out.ts] [--also <more.json> ...] [--tension <tension.json>] [--note \"...\"]" >&2; exit 2; }
exec "$ROOT/node_modules/.bin/tsx" "$ROOT/bin/_difficulty-import.ts" "$@"
