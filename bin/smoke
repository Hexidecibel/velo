#!/usr/bin/env bash
# Headless sanity check: boot the built client in Chrome, drive the bike with a
# scripted input stream, and assert that the page neither threw nor NaN'd.
#
# It then runs the fixed cross-engine harness in BOTH Chrome's V8 and Node's V8
# and asserts the state-hash chains are identical. That comparison is the only
# real proof that a server can one day re-simulate a browser's replay, which is
# the entire basis of a cheat-proof leaderboard.
#
# This is NOT a feel test — feel can only be judged by a human with hands on the
# keys. It exists to catch the boring failure where the bundle is broken, the
# canvas never paints, or the sim explodes into NaN within a second of the start
# line, none of which a node-only unit test can see.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
# THE TOOLING LEVELS, ASKED FOR BY NAME. This check drives `test01` end to end
# — in the page and against a real server — and a published build lists neither
# of the two test levels (src/shared/levelset.ts). So the bundle built here and
# the server _smoke.mjs spawns are both told to include them. That makes this
# dist/ a tooling build rather than the one that ships, which costs nothing:
# the service serves release/, and bin/deploy rebuilds dist/ before publishing.
export VITE_DEV_LEVELS=1
export VELO_DEV_LEVELS=1
echo "==> build (with the tooling levels)"
"$ROOT/bin/build" >/dev/null
echo "==> headless drive"
exec "$NODE" "$ROOT/bin/_smoke.mjs" "$@"
