#!/usr/bin/env bash
# Headless sanity check: boot the built client in Chrome, drive the bike with a
# scripted input stream, and assert that the page neither threw nor NaN'd.
#
# This is NOT a feel test — feel can only be judged by a human with hands on the
# keys. It exists to catch the boring failure where the bundle is broken, the
# canvas never paints, or the sim explodes into NaN within a second of the start
# line, none of which a node-only unit test can see.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
echo "==> build"
"$ROOT/bin/build" >/dev/null
echo "==> headless drive"
exec "$NODE" "$ROOT/bin/_smoke.mjs" "$@"
