#!/usr/bin/env bash
# Write the built-in levels out as JSON, into levels/.
#
#   bin/level-export            -> levels/test01.json, levels/test02-bowl.json
#   bin/level-export /tmp/out   -> the same two files, somewhere else
#
# The levels live in src/sim/*level.ts as plain data so that the sim's own tests
# can import them without touching the filesystem — `parseLevel` takes `unknown`
# and does not care where the object came from. This script exists to prove that
# claim: the emitted JSON is a worked example of the format, and
# `bin/level-check` reads it back and confirms the hashes are unchanged.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
OUT="${1:-$ROOT/levels}"
mkdir -p "$OUT"
echo "==> exporting the built-in levels"
"$ROOT/node_modules/.bin/tsx" -e "
  import { TEST_LEVEL } from './src/sim/testlevel.ts';
  import { CURVE_LEVEL } from './src/sim/curvelevel.ts';
  import { parseLevel } from './src/sim/level.ts';
  import { writeFileSync } from 'node:fs';
  import { join } from 'node:path';
  const dir = process.argv[1];
  for (const [file, data] of [['test01.json', TEST_LEVEL], ['test02-bowl.json', CURVE_LEVEL]] as const) {
    const lvl = parseLevel(data);
    const path = join(dir, file);
    writeFileSync(path, JSON.stringify(data, null, 2) + '\n');
    console.log('    ' + path);
    console.log('      simHash     ' + lvl.simHash);
    console.log('      contentHash ' + lvl.contentHash);
    console.log('      ' + lvl.polys.length + ' collidable polygons, ' + lvl.apples.length + ' apples, '
      + (lvl.arcCount ? lvl.arcCount + ' arcs -> ' + lvl.arcSegments + ' generated vertices' : 'no arcs'));
  }
" "$OUT"
