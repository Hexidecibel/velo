#!/usr/bin/env bash
# Validate hand-authored level JSON, print its two hashes, and warn about
# straight runs that are too coarse to ride smoothly.
#
#   bin/level-check levels/*.json
#
# Run this on anything you hand-edit BEFORE loading it. Two reasons:
#
#   * The loader rejects hard — a zero-length edge produces a NaN normal, and
#     one NaN poisons the whole state buffer within a tick — and it is much
#     nicer to see that as a message with a vertex index than as a bike that
#     silently vanishes.
#
#   * It also estimates the curve each vertex implies against its neighbours and
#     warns when the resulting sag is over the level's own sagTolerance. That is
#     how you catch a coarse polyline at authoring time rather than at 20 m/s.
#     It WARNS and never rejects: a deliberate hard edge is legitimate level
#     design, and a tool that called that an error is a tool you stop reading.
#
# Exit status is non-zero only when a file failed to LOAD.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
[[ $# -ge 1 ]] || { echo "usage: bin/level-check <file.json> [more.json ...]" >&2; exit 2; }
exec "$ROOT/node_modules/.bin/tsx" "$ROOT/bin/_level-check.ts" "$@"
