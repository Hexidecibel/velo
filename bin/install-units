#!/usr/bin/env bash
# =============================================================================
# velo — render this machine's systemd unit and install it
# =============================================================================
#
#   bin/install-units                 render, install, daemon-reload, enable
#   bin/install-units --print         render to stdout, change nothing
#   bin/install-units --status        what is installed, and whether it drifted
#
# THE FILES IN deploy/ ARE TEMPLATES, NOT UNITS TO COPY. Hand-writing a unit
# full of absolute paths into /etc/systemd/system is the failure mode this
# exists to prevent: the repo then has no record of what is actually running,
# the live unit and the committed one drift apart with nothing to notice, and a
# moved repo or a second checkout is a unit pointing at a directory that is not
# there. So deploy/velo.service carries three placeholders and this script is
# the only thing that fills them in — from the same sources every other script
# in bin/ already uses, never from anything typed here.
#
# It ENABLES the unit but does not start or restart it. Rewriting the unit of a
# running service and silently restarting it would make `bin/install-units` a
# deploy, which is bin/deploy's job; this one's contract is "/etc now matches
# deploy/". bin/deploy calls this and then restarts.
#
# Idempotent — safe to re-run after editing the template.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

UNIT_DIR=/etc/systemd/system
UNITS=("${SERVICE_NAME}.service")

# --- the three machine-specific values ---------------------------------------
# Every one of them is derived. ROOT and NODE come from _common.sh, which is
# also what bin/start and bin/status resolve, so the CLI and the service always
# agree about which repo and which node binary are in play.
UNIT_REPO="$ROOT"
# SUDO_USER first: `sudo bin/install-units` must still write `User=you`, not
# `User=root`. Nothing in this app wants privilege.
UNIT_USER="${SUDO_USER:-$(id -un)}"
UNIT_NODE_BIN="$(dirname "$NODE")"

# Pin the resolved node for anything that reads .node-path later. _common.sh
# already prefers this file, so writing it here makes the unit and every
# subsequent bin/ invocation agree on one binary instead of two shells
# disagreeing about what `node` means. Gitignored — machine-specific by
# definition.
printf '%s\n' "$NODE" > "$ROOT/.node-path"

# Render one template to stdout. Two transformations and nothing else, so that a
# directive in the template is a directive in /etc:
#   * `##` lines (notes to the template's editor) are dropped; plain `#`
#     comments survive, because several of them explain a choice.
#   * the three placeholders are substituted.
# `|` as the sed delimiter — every value here is a path.
render_unit() {
  local src="$ROOT/deploy/$1"
  [[ -f "$src" ]] || { echo "missing template $src" >&2; return 1; }
  cat <<HEADER
# Generated by bin/install-units from deploy/$1 — edits here are lost on the
# next deploy. Host-local settings go in ${UNIT_DIR}/$1.d/*.conf drop-ins,
# which this script never touches.
HEADER
  sed -e '/^##/d' \
      -e "s|@VELO_REPO@|${UNIT_REPO}|g" \
      -e "s|@VELO_USER@|${UNIT_USER}|g" \
      -e "s|@VELO_NODE_BIN@|${UNIT_NODE_BIN}|g" \
      "$src"
}

if [[ "${1:-}" == "--print" ]]; then
  for u in "${UNITS[@]}"; do render_unit "$u"; done
  exit 0
fi

if [[ "${1:-}" == "--status" ]]; then
  for u in "${UNITS[@]}"; do
    if [[ -f "${UNIT_DIR}/${u}" ]]; then
      # Diffed against the RENDERED unit, never the template — the template
      # matches no machine and never will.
      if render_unit "$u" | diff -q - "${UNIT_DIR}/${u}" >/dev/null; then
        printf '  ok      %-20s installed, matches deploy/\n' "$u"
      else
        printf '  DRIFT   %-20s installed but DIFFERS from deploy/\n' "$u"
      fi
    else
      printf '  MISSING %-20s not installed\n' "$u"
    fi
    # A drop-in is somebody's deliberate host-local config, so it is reported
    # rather than reconciled. A drop-in is never drift.
    if compgen -G "${UNIT_DIR}/${u}.d/*.conf" >/dev/null; then
      for c in "${UNIT_DIR}/${u}.d/"*.conf; do
        printf '  local   %-20s drop-in %s (host-local, left alone)\n' "$u" "$(basename "$c")"
      done
    fi
  done
  exit 0
fi

echo "==> Rendering units for this machine"
echo "    repo   $UNIT_REPO"
echo "    user   $UNIT_USER"
echo "    node   $UNIT_NODE_BIN ($("$NODE" -v))"

echo "==> Installing into $UNIT_DIR"
# Rendered to a private temp file first: `sudo install` cannot read a pipe, and
# writing into /etc directly leaves half a unit behind if the render fails.
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
for u in "${UNITS[@]}"; do
  render_unit "$u" > "$STAGE/$u"
  sudo install -m 0644 -o root -g root "$STAGE/$u" "$UNIT_DIR/$u"
  echo "    $u"
done

echo "==> Reloading systemd"
sudo systemctl daemon-reload

echo "==> Enabling ${SERVICE_NAME} (start on boot)"
# enable, NOT enable --now: see the header. Starting is bin/deploy's decision.
sudo systemctl enable "${SERVICE_NAME}.service" >/dev/null
echo "    enabled — run bin/restart (or bin/deploy) to apply a changed unit"
