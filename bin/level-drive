#!/usr/bin/env bash
# Drive a level headlessly and report whether every apple and the flower can
# actually be reached.
#
#   bin/level-drive levels/test01.json
#   bin/level-drive levels/*.json
#
# bin/level-check validates GEOMETRY — degenerate edges, non-finite coordinates,
# apples inside solid, coarse tessellation. It cannot tell you whether a level is
# COMPLETABLE, and the first hand-authored level in this repo shipped with apples
# nobody could reach. This is the cheap answer to that: a scripted rider that
# throttles when a wheel is down, lets go in the air, and leans into the face on
# a climb, run over a few route variations.
#
# It is a lower bound, not a proof: "some run reached it" means reachable, and
# "no run reached it" means only that this rider could not. Solver-backed
# reachability is the real fix and a later milestone.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
[[ $# -ge 1 ]] || { echo "usage: bin/level-drive <file.json> [more.json ...]" >&2; exit 2; }
exec "$ROOT/node_modules/.bin/tsx" -e "
  import { readFileSync } from 'node:fs';
  import { parseLevel } from './src/sim/level.ts';
  import { probeReachability } from './bin/_pilot.ts';
  import { BOOT_PRESET } from './src/client/presets.ts';
  import type { Cap } from './bin/_pilot.ts';
  // Route variations: straight through, or easing off over a window of the
  // level so that anything down a hole gets a chance to be dropped into.
  //
  // TWO cap speeds per window and OVERLAPPING windows, not one pass at 6 m/s.
  // The difference between flying a pit and dropping into it is a couple of
  // metres per second at the lip, so a single speed is a coin toss and a window
  // that starts in the wrong place misses the run-up entirely. This is still a
  // LOWER BOUND — 'some run reached it' proves reachable, 'no run reached it'
  // proves only that this rider could not — but a coarser search makes that
  // second case come up for levels that are actually fine, and a checker that
  // cries wolf is a checker nobody reads.
  let bad = 0;
  for (const f of process.argv.slice(1)) {
    const lvl = parseLevel(JSON.parse(readFileSync(f, 'utf8')));
    const span = lvl.maxX - lvl.minX;
    const routes: Cap[][] = [[]];
    const windows = 8;
    for (let i = 0; i < windows; i++) {
      const a = lvl.minX + (span * i) / windows;
      const w = (span / windows) * 1.6 + 3;
      for (const v of [4, 6]) routes.push([[a - w * 0.25, a + w, v]] as Cap[]);
    }
    const t0 = Date.now();
    const r = probeReachability(lvl, BOOT_PRESET.spec, routes);
    const miss = r.ever.map((v, i) => (v ? -1 : i)).filter((i) => i >= 0);
    console.log((r.finished ? '==> DRIVEABLE  ' : '==> INCOMPLETE ') + f);
    console.log('    ' + lvl.name);
    console.log('    apples reached  ' + r.ever.filter(Boolean).length + '/' + lvl.apples.length
      + (miss.length ? '   NOT REACHED: ' + miss.map((i) => i + ' at (' + lvl.apples[i].x + ', ' + lvl.apples[i].y + ')').join(', ') : ''));
    console.log('    best run        ' + r.best.outcome + ' at x ' + r.best.x.toFixed(1) + ' after ' + r.best.seconds.toFixed(1) + ' s');
    console.log('    ' + ((Date.now() - t0) / 1000).toFixed(1) + ' s of search');
    if (!r.finished) bad++;
  }
  process.exit(bad ? 1 : 0);
" "$@"
