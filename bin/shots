#!/usr/bin/env bash
# Screenshot the real renderer across levels, for judging READABILITY.
#
# Usage:
#   bin/shots                                  # the four levels that matter most
#   bin/shots 04-switchback 13-reservoir
#   SHOTS_OUT=/tmp/x SHOTS_W=1920 SHOTS_H=1080 bin/shots
#   SHOTS_QUERY=touch=1 bin/shots 01-first-light   # the phone thumb pads, which
#                                              # are page elements and therefore
#                                              # in the screenshot
#   SHOTS_MONTAGE=24 bin/shots 20-close-quarters   # the end-of-level montage:
#                                              # does the winning line still
#                                              # read against the crowd
#   SHOTS_ONLY=art-62 bin/shots 01-first-light 02-the-long-climb ...
#                                              # one shot per level, for judging
#                                              # the twenty AS A SET
#   SHOTS_BIKES=scrambler,cafe,moto,bobber,mono,trials SHOTS_ONLY=bike-scrambler,bike-cafe,bike-moto,bike-bobber,bike-mono,bike-trials bin/shots 01-first-light
#                                              # one shot per bike type at 110
#                                              # px/m: do six silhouettes read
#                                              # as six bikes? A comparison, not
#                                              # an opinion.
#   SHOTS_CHROME=1 SHOTS_ONLY=chooser,hud-off bin/shots 07-the-chimney
#                                              # the level chooser with its
#                                              # thumbnails drawn, and the frame
#                                              # with the debug readout off
#
# Five shots per level: art at the base camera, art zoomed in, art with the G
# collision overlay up, the OLD flat renderer at the same camera for an A/B, and
# the overview. The A/B pair is the point — "is the collision edge still the most
# legible line" is a comparison, not an opinion.
#
# Output goes to shots/ (gitignored).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
ensure_deps
cd "$ROOT"
echo "==> build"
"$ROOT/bin/build" >/dev/null
echo "==> shots"
exec "$NODE" "$ROOT/bin/_shots.mjs" "$@"
